#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/render-exercise-pdfs [options]

Render every numeric chapter exercise document, except chapter 00, as a PDF
that includes solutions and grading blocks.

Options:
  -o, --out-dir DIR  Output directory (default: site/pdfs/exercices)
  -h, --help         Show this help
EOF
}

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SITE_DIR="$PROJECT_ROOT/site"
CHAPTERS_DIR="$SITE_DIR/chapitres"
OUT_DIR="$PROJECT_ROOT/site/pdfs/exercices"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--out-dir)
      [[ $# -ge 2 ]] || { echo "render-exercise-pdfs: --out-dir requires a directory" >&2; exit 2; }
      OUT_DIR="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "render-exercise-pdfs: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$OUT_DIR" != /* ]]; then
  OUT_DIR="$PROJECT_ROOT/$OUT_DIR"
fi

mkdir -p "$OUT_DIR"
TMP_DIR="$(mktemp -d -t act4105-exercise-pdfs.XXXXXX)"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

count=0
failures=()

while IFS= read -r source; do
  chapter_dir="$(basename "$(dirname "$source")")"
  chapter_id="${chapter_dir%%-*}"

  [[ "$chapter_id" =~ ^[0-9]+$ ]] || continue
  [[ "$chapter_id" == "00" ]] && continue

  stage_dir="$TMP_DIR/$chapter_dir"
  output="$OUT_DIR/$chapter_dir.pdf"
  staged_pdf="$stage_dir/$chapter_dir.pdf"
  mkdir -p "$stage_dir"
  echo "render-exercise-pdfs: $chapter_dir -> $output" >&2

  if ! (
    cd "$SITE_DIR"
    "$SCRIPT_DIR/quarto" render "chapitres/$chapter_dir/exercices.qmd" \
      --profile exercices-pdf \
      --to exam-typst \
      --output-dir "$stage_dir" \
      --output "$chapter_dir.pdf"
  ); then
    failures+=("$chapter_dir")
    continue
  fi

  if [[ ! -s "$staged_pdf" ]]; then
    echo "render-exercise-pdfs: PDF not created for $chapter_dir" >&2
    failures+=("$chapter_dir")
    continue
  fi

  mv "$staged_pdf" "$output"
  count=$((count + 1))
done < <(find "$CHAPTERS_DIR" -mindepth 2 -maxdepth 2 -type f -name exercices.qmd -print | sort)

if [[ "$count" -eq 0 && "${#failures[@]}" -eq 0 ]]; then
  echo "render-exercise-pdfs: no numbered chapter exercise document found" >&2
  exit 1
fi

if [[ "${#failures[@]}" -gt 0 ]]; then
  echo "render-exercise-pdfs: failed chapters: ${failures[*]}" >&2
  exit 1
fi

echo "render-exercise-pdfs: wrote $count PDF(s) to $OUT_DIR" >&2
