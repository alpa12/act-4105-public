#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/render-diapos-pdfs [options]

Render every numeric chapter presentation, except chapter 00, as a PDF with
an H1/H2 navigation outline.

Options:
  -o, --out-dir DIR  Output directory (default: site/pdfs/diapos)
      --wait MS      Time to wait for RevealJS before printing (default: 15000)
  -h, --help         Show this help
EOF
}

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CHAPTERS_DIR="$PROJECT_ROOT/site/chapitres"
OUT_DIR="$PROJECT_ROOT/site/pdfs/diapos"
WAIT=15000

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--out-dir)
      OUT_DIR="$2"
      shift 2
      ;;
    --wait)
      WAIT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "render-diapos-pdfs: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$OUT_DIR" != /* ]]; then
  OUT_DIR="$PROJECT_ROOT/$OUT_DIR"
fi

[[ "$WAIT" =~ ^[0-9]+$ ]] || {
  echo "render-diapos-pdfs: --wait must be a number of milliseconds" >&2
  exit 2
}

mkdir -p "$OUT_DIR"

count=0
failures=()

while IFS= read -r source; do
  chapter_dir="$(basename "$(dirname "$source")")"
  chapter_id="${chapter_dir%%-*}"

  [[ "$chapter_id" =~ ^[0-9]+$ ]] || continue
  [[ "$chapter_id" == "00" ]] && continue

  output="$OUT_DIR/$chapter_dir.pdf"
  echo "render-diapos-pdfs: $chapter_dir -> $output" >&2

  if ! "$SCRIPT_DIR/revealjs-pdf" "$source" --out "$output" --wait "$WAIT" --outline-h1-h2; then
    failures+=("$chapter_dir")
    continue
  fi

  count=$((count + 1))
done < <(find "$CHAPTERS_DIR" -mindepth 2 -maxdepth 2 -type f -name diapos.qmd -print | sort)

if [[ "$count" -eq 0 && "${#failures[@]}" -eq 0 ]]; then
  echo "render-diapos-pdfs: no numbered chapter presentation found" >&2
  exit 1
fi

if [[ "${#failures[@]}" -gt 0 ]]; then
  echo "render-diapos-pdfs: failed chapters: ${failures[*]}" >&2
  exit 1
fi

echo "render-diapos-pdfs: wrote $count PDF(s) to $OUT_DIR" >&2
